  | HaveDryadDoStardewAnimation(_) => PacketTypeV1457.HaveDryadDoStardewAnimation
  | ItemDropShimmeredUpdate(_) => PacketTypeV1457.ItemDropShimmeredUpdate
  | ShimmerEffectOrCoinLuck(_) => PacketTypeV1457.ShimmerEffectOrCoinLuck
  | LoadoutSwitch(_) => PacketTypeV1457.LoadoutSwitch
  | ItemDropProtectedUpdate(_) => PacketTypeV1457.ItemDropProtectedUpdate
  | DeadCellsDisplayJarTryPlacing(_) => PacketTypeV1457.DeadCellsDisplayJarTryPlacing
  | PlayerSpectate(_) => PacketTypeV1457.PlayerSpectate
  | ItemDropClear(_) => PacketTypeV1457.ItemDropClear
  | PlayerItemUseSound(_) => PacketTypeV1457.PlayerItemUseSound
  | NpcHurtByDebuff(_) => PacketTypeV1457.NpcHurtByDebuff
  | Ping(_) => PacketTypeV1457.Ping
  | ChestResize(_) => PacketTypeV1457.ChestResize
  | LeashedEntityAnchorInsertItem(_) => PacketTypeV1457.LeashedEntityAnchorInsertItem
  | PlayerTeamUpdate(_) => PacketTypeV1457.PlayerTeamUpdate
  | PlayerTeamSwapSpawn(_) => PacketTypeV1457.PlayerTeamSwapSpawn
  | SectionRequest(_) => PacketTypeV1457.SectionRequest
  | ItemDropPosition(_) => PacketTypeV1457.ItemDropPosition
  | HostToken(_) => PacketTypeV1457.HostToken
  | DamageNPCAck(_) => PacketTypeV1457.DamageNPCAck
  | ServerInfo(_) => PacketTypeV1457.ServerInfo
  | PlayerPlatformInfo(_) => PacketTypeV1457.PlayerPlatformInfo
  }

let directionOfPacketType = (packetType: PacketTypeV1457.t): direction =>
  switch packetType {
  | ConnectRequest
  | WorldDataRequest
  | InitialTileSectionsRequest
  | ChestOpen
  | PasswordSend
  | SignRead
  | BossOrInvasionSpawn
  | ClientUuid
  | NpcCatch
  | NpcRelease
  | AnglerQuestComplete
  | TileEntityPlace
  | ItemFramePlace
  | PortalKill
  | GemLockToggle
  | MassWireOperation
  | PartyToggle
  | CrystalInvasionStart
  | Emoji
  | WeaponsRackTryPlacing
  | NpcFishOut
  | FoodPlatterTryPlacing
  | NpcBuffRemovalRequest
  | ClientSyncedInventory
  | PlayerPlatformInfo =>
    ClientOnly
  | Disconnect
  | PlayerSlotSet
  | WorldInfo
  | Status
  | TileSectionSend
  | TileSectionFrame
  | PlayerActive
  | TimeSet
  | NpcUpdate
  | PasswordRequired
  | PlayerSpawnSelf
  | NpcBuffUpdate
  | GoodEvilUpdate
  | TravellingMerchantInventory
  | AnglerQuest
  | TemporaryAnimationCreate
  | InvasionProgressReport
  | PlayerChestIndexSync
  | CombatNumberCreate
  | NpcKillCount
  | TileEntityUpdate
  | ItemDropModify
  | EmoteBubble
  | NpcKilledNotification
  | EventNotification
  | ShieldStrengthsUpdate
  | MoonLordCountdown
  | NpcShopItem
  | SmokePoof
  | ChatMessageSmart
  | WiredCannonShot
  | MassWireOperationPay
  | CrystalInvasionWipeAll
  | CrystalInvasionSendWaitTime
  | CombatTextCreate
  | RevengeMarkerSync
  | RevengeMarkerRemove
  | ClientFinishConnectingToServer
  | NpcTamper
  | LegacySoundPlay
  | PlayerDead
  | DamageNPCAck
  | ServerInfo =>
    ServerOnly
  | _ => Both
  }

let directionError = (
  _packetType: PacketTypeV1457.t,
  fromServer: bool,
): ISerializer.toBufferResult => Error({
  context: "Packet.toBuffer",
  error: JsError.make(
    fromServer
      ? "Cannot serialize a client-only packet from the server side"
      : "Cannot serialize a server-only packet from the client side",
  )->JsError.toJsExn,
})

let guardDirection = (packetType: PacketTypeV1457.t, fromServer: bool): option<
  ISerializer.toBufferResult,
> =>
  switch (directionOfPacketType(packetType), fromServer) {
  | (Both, _) => None
  | (ServerOnly, true) => None
  | (ClientOnly, false) => None
  | (_, _) => Some(directionError(packetType, fromServer))
  }

