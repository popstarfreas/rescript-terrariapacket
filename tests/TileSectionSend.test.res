let tt =  (t, data) => {
  let data = NodeJs.Buffer.fromStringWithEncoding(data,
    NodeJs.StringEncoding.hex,
  )
  let result = PacketV1449.TileSectionSend.parse(data)
  switch result {
  | Ok(value) => {
      let data2 = PacketV1449.TileSectionSend.toBuffer(value)
      switch data2 {
      | Error(err) => t->fail(~msg=JsExn.message(err.error)->Option.getOrThrow)
      | Ok(data2) =>
        let a = NodeJs.Buffer.toStringWithEncoding(data, NodeJs.StringEncoding.hex)
        let b = NodeJs.Buffer.toStringWithEncoding(data2, NodeJs.StringEncoding.hex)
        t->ok(a == b)
      }
    }
  | Error(err) => t->fail(~msg=JsExn.message(err.error)->Option.getOrThrow)
  }

}
let ttv145 =  (t, data) => {
  let data = NodeJs.Buffer.fromStringWithEncoding(data,
    NodeJs.StringEncoding.hex,
  )
  let result = Packet.TileSectionSend.parse(data)
  switch result {
  | Ok(value) => {
      let data2 = Packet.TileSectionSend.toBuffer(value)
      switch data2 {
      | Error(err) => t->fail(~msg=JsExn.message(err.error)->Option.getOrThrow)
      | Ok(data2) =>
        let a = NodeJs.Buffer.toStringWithEncoding(data, NodeJs.StringEncoding.hex)
        let b = NodeJs.Buffer.toStringWithEncoding(data2, NodeJs.StringEncoding.hex)
        t->ok(a == b)
      }
    }
  | Error(err) => t->fail(~msg=JsExn.message(err.error)->Option.getOrThrow)
  }

}
zoraBlock("should correctly parse and serialise TileSectionSend (5)", t => {
  tt(t, "")
})


