open Zora

zoraBlock("should correctly parse and serialise TileSectionSend", t => {
  let data = NodeJs.Buffer.fromStringWithEncoding(
    "",
    NodeJs.StringEncoding.hex,
  )
  let result = PacketV1449.TileSectionSend.parse(data)
  switch result {
  | Ok(_) => t->ok(true)
  | Error(err) => t->fail(~msg=JsExn.message(err.error)->Option.getOrThrow)
  }
})
zoraBlock("should correctly parse and serialise TileSectionSend (2)", t => {
  let data = NodeJs.Buffer.fromStringWithEncoding(
    "",
    NodeJs.StringEncoding.hex,
  )
  let result = PacketV1449.TileSectionSend.parse(data)
  switch result {
  | Ok(_) => t->ok(true)
  | Error(err) => t->fail(~msg=JsExn.message(err.error)->Option.getOrThrow)
  }
})

zoraBlock("should correctly parse and serialise TileSectionSend (3)", t => {
  let data = NodeJs.Buffer.fromStringWithEncoding(
    "",
    NodeJs.StringEncoding.hex,
  )
  let result = PacketV1449.TileSectionSend.parse(data)
  switch result {
  | Ok(value) => {
      let data2 = PacketV1449.TileSectionSend.toBuffer(value)
      switch data2 {
      | Error(err) => t->fail(~msg=JsExn.message(err.error)->Option.getOrThrow)
      | Ok(data2) =>
        let a = NodeJs.Buffer.toStringWithEncoding(data, NodeJs.StringEncoding.hex)
        let b = NodeJs.Buffer.toStringWithEncoding(data2, NodeJs.StringEncoding.hex)
        t->ok(a == b)
      }
    }
  | Error(err) => t->fail(~msg=JsExn.message(err.error)->Option.getOrThrow)
  }
})

